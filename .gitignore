# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.gstack/

# --- EMPOWER archive (added 2026-09-04) ---
# Plaintext credential — belongs in Infisical, never in git
hiwa-account-in-community-empower.json
# Python bytecode from archive tooling
__pycache__/
*.pyc
# Lesson videos: 453 MB, one file exceeds GitHub's 100 MB hard limit.
# Kept on disk only. See specs/roadmap.md.
empower-curriculum/**/*.mp4
empower-curriculum/**/*.mov
empower-curriculum/**/*.webm
# Separate git repo that lives in this directory — not part of this project
/loopbreaker/

# --- A.I. Marketing Club archive (added 2026-09-04) ---
# Plaintext member credential — belongs in Infisical, never in git
eben-pagan-members.marketingclub.ai.md
# Verbatim /api/members payload: 975 records incl. email addresses.
# The committed 04-members/ views have contact fields stripped. See GAPS.md #6.
marketingclub-archive/raw-json/members.json
# This account's own profile payloads carry its login email. Regenerated by
# `fetch_all.py`; the non-identifying bits already surface in 04-members/README.md.
marketingclub-archive/raw-json/auth-user.json
marketingclub-archive/raw-json/members-me.json
# Audio/video: 64 files, >1 GB. Linked from the Markdown; pull with
# `python3 .tools/fetch_files.py --media`. See GAPS.md #5.
marketingclub-archive/**/*.mp3
marketingclub-archive/**/*.mp4
marketingclub-archive/**/*.m4a
marketingclub-archive/**/*.wav
marketingclub-archive/**/*.mov
marketingclub-archive/**/*.webm

# --- Bayan marketing-plan materials (added 2026-09-21) ---
# LIVE browser session cookies (ChatGPT/Gemini auth tokens) — never commit.
# Belong nowhere in git; used only to export the conversations, then delete.
**/*cookies*.txt
**/*_cookies*.txt
# Raw LLM conversation exports: personal/PII-bearing, used as plan source
# material only. Compiled outputs (research.md, company-profile.md) are what
# gets committed, not these raws. Un-ignore specific files if ever needed.
marketing-plans/**/materials/chatgpt_full/
marketing-plans/**/materials/chatgpt_full_history.*
marketing-plans/**/materials/*_conversations.*
# Gemini exports (added 2026-09-21) — same PII policy as ChatGPT raws.
marketing-plans/**/materials/gemini_full/
marketing-plans/**/materials/*_full_history.*
# CEO transcripts + screenshots: private buyer VOC, never commit the raws.
marketing-plans/**/materials/Nasim-CEO*/
marketing-plans/**/materials/google_drive_bayan.json

# --- Corey Ganim credentials (untracked 2026-09-22) ---
# Plaintext login — belongs in Infisical, never in git. Already leaked to
