<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Astra — Marketing Plan v1</title>
<style>
  *{box-sizing:border-box;margin:0;padding:0}

  :root{
    --bg:#07090f;
    --txt:#e8edf7;
    --muted:#8b97ad;
    --faint:#5b6679;
    --line:rgba(255,255,255,.08);
    --line-2:rgba(255,255,255,.18);
    --mono:ui-monospace,SFMono-Regular,"SF Mono",Menlo,Consolas,monospace;
    --sans:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;
    --sidebar-w:260px;
    --topbar-h:58px;
    --accent:#a78bfa;
  }

  html{-webkit-text-size-adjust:100%; scroll-behavior:smooth}

  body{
    font-family:var(--sans);
    background:var(--bg);
    color:var(--txt);
    line-height:1.6;
    min-height:100vh;
    overflow-x:hidden;
    -webkit-font-smoothing:antialiased;
  }

  /* ═══════════ AMBIENT BACKGROUND ═══════════ */

  .bg-ambient{
    position:fixed; inset:0; z-index:0; pointer-events:none;
    overflow:hidden;
  }
  .bg-ambient::before{
    content:'';
    position:absolute; inset:-20%;
    background:
      radial-gradient(700px 500px at 20% 10%, rgba(167,139,250,.18), transparent 65%),
      radial-gradient(600px 500px at 85% 30%, rgba(96,165,250,.13), transparent 65%),
      radial-gradient(700px 500px at 50% 90%, rgba(244,114,182,.09), transparent 65%);
    animation:drift 26s ease-in-out infinite alternate;
  }
  @keyframes drift{
    0%{transform:translate(0,0) scale(1)}
    50%{transform:translate(2%, -1%) scale(1.04)}
    100%{transform:translate(-1%, 1%) scale(1.02)}
  }

  .orb{
    position:absolute; border-radius:50%;
    filter:blur(60px); opacity:.35;
    animation:float 18s ease-in-out infinite;
  }
  .orb.o1{width:280px; height:280px; background:#a78bfa; top:8%; left:6%}
  .orb.o2{width:220px; height:220px; background:#60a5fa; top:32%; right:9%; animation-delay:-6s}
  .orb.o3{width:260px; height:260px; background:#f472b6; bottom:12%; left:22%; animation-delay:-12s; opacity:.22}

  @keyframes float{
    0%,100%{transform:translate(0,0) scale(1)}
    33%{transform:translate(24px, -30px) scale(1.08)}
    66%{transform:translate(-18px, 22px) scale(0.95)}
  }

  /* star field */
  .stars{
    position:absolute; inset:0;
    background-image:
      radial-gradient(1px 1px at 12% 22%, rgba(255,255,255,.7), transparent),
      radial-gradient(1px 1px at 34% 71%, rgba(255,255,255,.5), transparent),
      radial-gradient(1.5px 1.5px at 56% 18%, rgba(255,255,255,.8), transparent),
      radial-gradient(1px 1px at 78% 44%, rgba(255,255,255,.55), transparent),
      radial-gradient(1px 1px at 91% 82%, rgba(255,255,255,.6), transparent),
      radial-gradient(1px 1px at 22% 88%, rgba(255,255,255,.45), transparent),
      radial-gradient(1.5px 1.5px at 68% 92%, rgba(255,255,255,.75), transparent),
      radial-gradient(1px 1px at 45% 52%, rgba(255,255,255,.4), transparent),
      radial-gradient(1px 1px at 8% 62%, rgba(255,255,255,.5), transparent),
      radial-gradient(1px 1px at 88% 12%, rgba(255,255,255,.55), transparent);
    animation:twinkle 6s ease-in-out infinite alternate;
  }
  @keyframes twinkle{
    0%{opacity:.5}
    100%{opacity:1}
  }

  /* cursor glow */
  .cursor-glow{
    position:fixed; width:520px; height:520px;
    border-radius:50%; pointer-events:none; z-index:1;
    background:radial-gradient(closest-side, rgba(167,139,250,.1), transparent 72%);
    transform:translate(-50%, -50%);
    transition:opacity .4s;
    opacity:0;
    mix-blend-mode:screen;
  }
  body:hover .cursor-glow{opacity:1}

  /* ═══════════ TOPBAR ═══════════ */

  .topbar{
    position:sticky; top:0; z-index:60;
    height:var(--topbar-h);
    background:rgba(7,9,15,.78);
    backdrop-filter:blur(16px) saturate(1.4);
    -webkit-backdrop-filter:blur(16px) saturate(1.4);
    border-bottom:1px solid var(--line);
  }

  .topbar-inner{
    display:flex; align-items:center; gap:14px;
    height:100%; padding:0 22px;
  }

  .brand{
    display:flex; align-items:center; gap:10px;
    font-size:13px; font-weight:650; letter-spacing:-.01em;
    white-space:nowrap;
  }
  .brand-mark{
    width:24px; height:24px; border-radius:7px;
    background:conic-gradient(from 220deg, #a78bfa, #60a5fa, #f472b6, #a78bfa);
    box-shadow:0 0 18px rgba(167,139,250,.55);
    flex:none;
    animation:spinGlow 8s linear infinite;
  }
  @keyframes spinGlow{
    0%{box-shadow:0 0 18px rgba(167,139,250,.55)}
    50%{box-shadow:0 0 22px rgba(96,165,250,.6)}
    100%{box-shadow:0 0 18px rgba(167,139,250,.55)}
  }
  .brand-sub{
    font-family:var(--mono); font-size:10.5px;
    color:var(--faint); letter-spacing:.04em;
    padding-left:10px; margin-left:2px;
    border-left:1px solid var(--line);
    white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
  }

  .topbar-spacer{flex:1}

  .view-toggle{
    display:flex; align-items:center; gap:2px;
    padding:3px; border-radius:10px;
    border:1px solid var(--line);
    background:rgba(255,255,255,.03);
    font-size:11.5px;
    position:relative;
  }
  .view-btn{
    all:unset;
    padding:5px 12px; border-radius:7px;
    color:var(--muted); cursor:pointer;
    transition:color .2s, background .3s;
    white-space:nowrap; position:relative; z-index:1;
  }
  .view-btn:hover{color:#fff}
  .view-btn.is-active{color:#fff}
  .view-pill{
    position:absolute;
    top:3px; bottom:3px;
    border-radius:7px;
    background:rgba(255,255,255,.09);
    transition:left .35s cubic-bezier(.5,.2,.2,1), width .35s cubic-bezier(.5,.2,.2,1);
    box-shadow:0 1px 0 rgba(255,255,255,.06) inset;
  }

  .print-btn{
    all:unset;
    display:flex; align-items:center; gap:6px;
    padding:6px 12px; border-radius:8px;
    font-size:11.5px; color:var(--muted);
    border:1px solid var(--line);
    cursor:pointer;
    transition:background .2s, color .2s, border-color .2s, transform .15s;
    white-space:nowrap;
  }
  .print-btn:hover{background:rgba(255,255,255,.06); color:#fff; border-color:var(--line-2); transform:translateY(-1px)}
  .print-btn svg{width:13px; height:13px}

  .progress-track{
    position:absolute; bottom:-1px; left:0; right:0;
    height:2px;
    background:transparent;
  }
  .progress-fill{
    height:100%; width:0%;
    background:linear-gradient(90deg, #a78bfa, #60a5fa 40%, #22d3ee 70%, #f472b6);
    box-shadow:0 0 12px rgba(167,139,250,.7);
    transition:width .12s linear;
    border-radius:0 2px 2px 0;
  }

  /* ═══════════ LAYOUT ═══════════ */

  .layout{
    position:relative; z-index:2;
    display:grid;
    grid-template-columns:var(--sidebar-w) 1fr;
    max-width:1480px;
    margin:0 auto;
  }

  /* ═══════════ SIDEBAR ═══════════ */

  .sidebar{
    position:sticky;
    top:var(--topbar-h);
    height:calc(100vh - var(--topbar-h));
    overflow-y:auto;
    padding:26px 14px 60px 22px;
    border-right:1px solid var(--line);
  }
  .sidebar::-webkit-scrollbar{width:6px}
  .sidebar::-webkit-scrollbar-thumb{background:rgba(255,255,255,.08); border-radius:3px}

  .side-label{
    font-size:9.5px; letter-spacing:.16em; text-transform:uppercase;
    color:var(--faint); font-weight:600;
    padding:0 10px 12px;
    display:flex; align-items:center; gap:8px;
  }
  .side-label::after{
    content:'';
    flex:1; height:1px;
    background:linear-gradient(90deg, var(--line), transparent);
  }

  .side-nav{display:flex; flex-direction:column; gap:1px; position:relative}

  .side-item{
    all:unset;
    display:flex; align-items:center; gap:11px;
    padding:8px 10px; border-radius:8px;
    font-size:12.5px; color:var(--muted);
    cursor:pointer;
    transition:background .2s, color .2s, transform .25s;
    position:relative;
    line-height:1.3;
  }
  .side-item:hover{background:rgba(255,255,255,.04); color:#dbe4f2; transform:translateX(2px)}
  .side-item.is-active{background:rgba(255,255,255,.055); color:#fff}
  .side-item.is-active::before{
    content:'';
    position:absolute; left:-22px; top:50%;
    width:2px; height:16px; border-radius:2px;
    transform:translateY(-50%);
    background:var(--sc);
    box-shadow:0 0 12px var(--sc);
    animation:pulseBar 2.4s ease-in-out infinite;
  }
  @keyframes pulseBar{
    0%,100%{box-shadow:0 0 12px var(--sc)}
    50%{box-shadow:0 0 20px var(--sc), 0 0 30px color-mix(in srgb, var(--sc) 50%, transparent)}
  }

  .side-num{
    font-family:var(--mono); font-size:10px;
    color:var(--faint); font-weight:600;
    flex:none; width:18px;
    font-variant-numeric:tabular-nums;
    transition:color .2s;
  }
  .side-item.is-active .side-num{color:var(--sc)}
  .side-title{flex:1; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap}

  /* ═══════════ MAIN ═══════════ */

  main{padding:0 56px 130px; max-width:940px; min-width:0}

  /* ═══════════ HERO ═══════════ */

  .hero{
    padding:60px 0 40px;
    position:relative;
  }

  .eyebrow{
    display:inline-flex; align-items:center; gap:8px;
    font-size:10.5px; letter-spacing:.18em; text-transform:uppercase;
    color:var(--muted); padding:6px 14px; border-radius:999px;
    border:1px solid var(--line); background:rgba(255,255,255,.03);
    opacity:0; animation:riseIn .7s .1s cubic-bezier(.2,.7,.3,1) forwards;
  }
  .eyebrow i{
    width:6px; height:6px; border-radius:50%;
    background:#a78bfa; box-shadow:0 0 12px #a78bfa;
    animation:blink 2.4s ease-in-out infinite;
  }
  @keyframes blink{
    0%,100%{opacity:1}
    50%{opacity:.35}
  }

  .hero h1{
    font-size:clamp(32px,4.8vw,54px);
    font-weight:700; letter-spacing:-.038em; line-height:1.05;
    margin:22px 0 0;
    max-width:820px;
    opacity:0; animation:riseIn .8s .2s cubic-bezier(.2,.7,.3,1) forwards;
  }
  .hero h1 .grad{
    background:linear-gradient(100deg,#a78bfa,#60a5fa 38%,#22d3ee 66%,#f472b6 92%);
    background-size:200% 100%;
    -webkit-background-clip:text; background-clip:text; color:transparent;
    animation:gradShift 8s ease infinite;
  }
  @keyframes gradShift{
    0%,100%{background-position:0% 50%}
    50%{background-position:100% 50%}
  }

  .hero p.lede{
    color:var(--muted); font-size:15.5px; max-width:600px;
    margin-top:20px; line-height:1.65;
    opacity:0; animation:riseIn .8s .3s cubic-bezier(.2,.7,.3,1) forwards;
  }
  .hero p.lede strong{color:#dbe4f2; font-weight:600}
  .hero p.lede em{color:#c9d4e6; font-style:normal; font-family:var(--mono); font-size:13.5px}

  @keyframes riseIn{
    from{opacity:0; transform:translateY(14px)}
    to{opacity:1; transform:translateY(0)}
  }

  .hero-grid{
    display:grid;
    grid-template-columns:1fr 380px;
    gap:48px;
    align-items:center;
    margin-top:8px;
  }

  @media (max-width:1100px){
    .hero-grid{grid-template-columns:1fr; gap:40px}
  }

  /* ───────────── FUNNEL VISUAL ───────────── */

  .funnel-wrap{
    position:relative;
    padding:24px 0;
    opacity:0;
    animation:riseIn .9s .5s cubic-bezier(.2,.7,.3,1) forwards;
  }

  .funnel{
    position:relative;
    display:flex; flex-direction:column; gap:9px;
    padding:22px 20px;
    border-radius:20px;
    border:1px solid var(--line);
    background:linear-gradient(180deg, rgba(255,255,255,.028), rgba(255,255,255,.006));
    backdrop-filter:blur(8px);
    overflow:hidden;
  }
  .funnel::before{
    content:'';
    position:absolute; inset:0;
    background:
      radial-gradient(200px 120px at 50% 0%, rgba(167,139,250,.16), transparent 70%),
      radial-gradient(200px 120px at 50% 100%, rgba(244,114,182,.1), transparent 70%);
    pointer-events:none;
  }

  .funnel-flow{
    position:absolute;
    left:50%; top:22px; bottom:22px;
    width:1px;
    transform:translateX(-50%);
    background:linear-gradient(180deg,
      rgba(167,139,250,.4),
      rgba(96,165,250,.4) 25%,
      rgba(34,211,238,.4) 55%,
      rgba(192,132,252,.4) 78%,
      rgba(244,114,182,.4));
    pointer-events:none;
    z-index:0;
  }
  .funnel-flow::after{
    content:'';
    position:absolute; left:50%;
    width:8px; height:8px;
    border-radius:50%;
    background:#fff;
    transform:translate(-50%, -50%);
    box-shadow:0 0 18px 4px rgba(167,139,250,.9), 0 0 30px 8px rgba(96,165,250,.5);
    animation:flowDown 5s linear infinite;
  }
  @keyframes flowDown{
    0%{top:0%; opacity:0}
    10%{opacity:1}
    90%{opacity:1}
    100%{top:100%; opacity:0}
  }

  .funnel-stage{
    position:relative;
    display:flex;
    justify-content:center;
    z-index:1;
    opacity:0;
    animation:stageIn .7s cubic-bezier(.2,.7,.3,1) forwards;
  }
  .funnel-stage:nth-child(2){animation-delay:.65s}
  .funnel-stage:nth-child(3){animation-delay:.75s}
  .funnel-stage:nth-child(4){animation-delay:.85s}
  .funnel-stage:nth-child(5){animation-delay:.95s}
  .funnel-stage:nth-child(6){animation-delay:1.05s}

  @keyframes stageIn{
    from{opacity:0; transform:scaleX(.6)}
    to{opacity:1; transform:scaleX(1)}
  }

  .fs-inner{
    width:var(--w, 100%);
    display:flex; align-items:center; gap:10px;
    padding:10px 16px;
    border-radius:12px;
    background:linear-gradient(90deg,
      color-mix(in srgb, var(--c) 22%, rgba(255,255,255,.02)),
      color-mix(in srgb, var(--c) 8%, rgba(255,255,255,.02)));
    border:1px solid color-mix(in srgb, var(--c) 38%, transparent);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--c) 12%, transparent),
      0 12px 32px -18px var(--c);
    transition:transform .3s cubic-bezier(.2,.7,.3,1), box-shadow .3s;
    cursor:default;
  }
  .fs-inner:hover{
    transform:translateX(4px);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--c) 25%, transparent),
      0 18px 44px -18px var(--c);
  }

  .fs-dot{
    width:8px; height:8px; border-radius:50%;
    background:var(--c); box-shadow:0 0 12px var(--c);
    flex:none;
  }
  .fs-label{
    font-size:12.5px; font-weight:650; letter-spacing:-.005em;
    color:#eef3fb;
    flex:1;
    white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
  }
  .fs-count{
    font-family:var(--mono); font-size:11.5px; font-weight:600;
    color:color-mix(in srgb, var(--c) 80%, #fff);
    font-variant-numeric:tabular-nums;
    flex:none;
  }

  .funnel-caption{
    text-align:center;
    font-family:var(--mono); font-size:10px;
    color:var(--faint); letter-spacing:.14em;
    text-transform:uppercase;
    margin-top:14px;
  }

  /* ───────────── METADATA ───────────── */

  .meta{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(140px,1fr));
    gap:0;
    margin-top:36px;
    border:1px solid var(--line);
    border-radius:14px;
    overflow:hidden;
    background:rgba(255,255,255,.015);
    opacity:0; animation:riseIn .8s .55s cubic-bezier(.2,.7,.3,1) forwards;
  }
  .meta-cell{
    padding:14px 16px;
    border-right:1px solid var(--line);
    border-bottom:1px solid var(--line);
    transition:background .2s;
  }
  .meta-cell:hover{background:rgba(255,255,255,.025)}
  .meta-cell:last-child{border-right:none}
  .meta-key{
    font-size:9.5px; letter-spacing:.14em; text-transform:uppercase;
    color:var(--faint); font-weight:600;
    margin-bottom:6px;
  }
  .meta-val{
    font-family:var(--mono); font-size:12.5px;
    color:#dbe4f2; letter-spacing:-.005em;
  }
  .meta-val.empty{color:var(--faint); font-style:italic}

  /* ───────────── STATS ───────────── */

  .stats{
    display:grid;
    grid-template-columns:repeat(auto-fit, minmax(120px, 1fr));
    gap:10px;
    margin-top:22px;
    opacity:0; animation:riseIn .8s .7s cubic-bezier(.2,.7,.3,1) forwards;
  }
  .stat{
    position:relative;
    display:flex; flex-direction:column; gap:2px;
    padding:16px 18px 15px;
    border-radius:14px;
    border:1px solid var(--line);
    background:linear-gradient(180deg,rgba(255,255,255,.028),rgba(255,255,255,.008));
    overflow:hidden;
    transition:transform .25s cubic-bezier(.2,.7,.3,1), border-color .25s, box-shadow .25s;
  }
  .stat::before{
    content:'';
    position:absolute; top:0; left:0; right:0; height:2px;
    background:linear-gradient(90deg, transparent, var(--sc, #a78bfa), transparent);
    opacity:.5;
    transition:opacity .25s;
  }
  .stat:hover{
    transform:translateY(-3px);
    border-color:var(--line-2);
    box-shadow:0 18px 40px -26px var(--sc, #a78bfa);
  }
  .stat:hover::before{opacity:1}

  .stat b{
    font-size:26px; font-weight:700; letter-spacing:-.03em;
    font-variant-numeric:tabular-nums;
    color:#fff;
    line-height:1.1;
  }
  .stat span{
    font-size:10px; color:var(--muted);
    letter-spacing:.12em; text-transform:uppercase;
    font-weight:600;
  }

  /* ═══════════ SECTIONS ═══════════ */

  .sections{
    position:relative;
    display:flex; flex-direction:column; gap:14px;
    margin-top:56px;
    padding-left:34px;
  }

  .sections::before{
    content:'';
    position:absolute; left:11px; top:14px; bottom:14px;
    width:1px;
    background:linear-gradient(180deg,
      rgba(148,163,184,.05),
      rgba(148,163,184,.14) 20%,
      rgba(148,163,184,.14) 80%,
      rgba(148,163,184,.05));
  }

  .section{
    position:relative;
    border-radius:18px;
    border:1px solid var(--line);
    background:linear-gradient(180deg, rgba(255,255,255,.026), rgba(255,255,255,.005));
    overflow:hidden;
    scroll-margin-top:calc(var(--topbar-h) + 22px);
    transition:
      border-color .3s,
      background .3s,
      transform .4s cubic-bezier(.2,.7,.3,1),
      opacity .6s cubic-bezier(.2,.7,.3,1),
      box-shadow .3s;
    opacity:0;
    transform:translateY(24px);
  }
  .section.in-view{
    opacity:1;
    transform:translateY(0);
  }
  .section::before{
    content:'';
    position:absolute; top:0; left:0; right:0; height:2px;
    background:linear-gradient(90deg, transparent, var(--sc), transparent);
    opacity:.55;
    transition:opacity .3s;
  }
  .section:hover{
    border-color:var(--line-2);
    background:linear-gradient(180deg, rgba(255,255,255,.038), rgba(255,255,255,.01));
  }
  .section.is-open::before{opacity:1}

  .section::after{
    content:'';
    position:absolute; left:-28px; top:26px;
    width:11px; height:11px; border-radius:50%;
    background:var(--bg);
    border:2px solid color-mix(in srgb, var(--sc) 50%, transparent);
    box-shadow:0 0 12px color-mix(in srgb, var(--sc) 40%, transparent);
    transition:border-color .3s, box-shadow .3s, transform .3s;
  }
  .section.in-view::after{
    border-color:var(--sc);
    box-shadow:0 0 16px var(--sc), 0 0 28px color-mix(in srgb, var(--sc) 40%, transparent);
  }
  .section.is-open::after{
    transform:scale(1.25);
  }

  .section-head{
    display:flex; align-items:flex-start; gap:16px;
    padding:22px 26px 18px;
    cursor:pointer;
    user-select:none;
  }

  .sec-icon{
    flex:none;
    width:42px; height:42px;
    border-radius:11px;
    display:flex; align-items:center; justify-content:center;
    background:linear-gradient(135deg,
      color-mix(in srgb, var(--sc) 22%, transparent),
      color-mix(in srgb, var(--sc) 8%, transparent));
    border:1px solid color-mix(in srgb, var(--sc) 32%, transparent);
    color:var(--sc);
    transition:transform .4s cubic-bezier(.2,.7,.3,1), box-shadow .3s, border-color .3s;
    position:relative;
  }
  .sec-icon::before{
    content:'';
    position:absolute; inset:-1px;
    border-radius:inherit;
    background:radial-gradient(closest-side, color-mix(in srgb, var(--sc) 24%, transparent), transparent);
    opacity:0;
    transition:opacity .3s;
  }
  .sec-icon svg{
    width:19px; height:19px;
    stroke-width:1.8;
    position:relative; z-index:1;
    transition:transform .4s cubic-bezier(.2,.7,.3,1);
  }
  .section:hover .sec-icon{
    transform:scale(1.06);
    border-color:color-mix(in srgb, var(--sc) 55%, transparent);
  }
  .section:hover .sec-icon::before{opacity:1}
  .section:hover .sec-icon svg{transform:scale(1.08)}
  .section.is-open .sec-icon{
    box-shadow:0 0 0 1px color-mix(in srgb, var(--sc) 30%, transparent),
                0 14px 30px -18px var(--sc);
  }

  .sec-head-text{flex:1; min-width:0; padding-top:2px}
  .sec-title{
    font-size:16.5px; font-weight:650; letter-spacing:-.015em;
    color:#eef3fb; line-height:1.25;
    display:flex; align-items:baseline; gap:9px;
    flex-wrap:wrap;
  }
  .sec-num-inline{
    font-family:var(--mono); font-size:10.5px;
    color:var(--sc); font-weight:700;
    letter-spacing:.04em;
    font-variant-numeric:tabular-nums;
    transition:color .3s;
  }
  .sec-purpose{
    font-size:12.5px; color:var(--muted);
    margin-top:7px; line-height:1.55;
  }

  .sec-toggle{
    flex:none;
    width:28px; height:28px; border-radius:8px;
    display:flex; align-items:center; justify-content:center;
    border:1px solid var(--line);
    color:var(--faint);
    background:rgba(255,255,255,.02);
    transition:transform .35s cubic-bezier(.2,.7,.3,1), color .25s, border-color .25s, background .25s;
    margin-top:3px;
  }
  .section.is-open .sec-toggle{
    transform:rotate(180deg);
    color:var(--sc);
    border-color:color-mix(in srgb, var(--sc) 42%, transparent);
    background:color-mix(in srgb, var(--sc) 8%, transparent);
  }
  .section:hover .sec-toggle{color:#fff}

  .sec-body{
    display:grid;
    grid-template-rows:0fr;
    transition:grid-template-rows .45s cubic-bezier(.3,.7,.3,1);
  }
  .section.is-open .sec-body{
    grid-template-rows:1fr;
  }
  .sec-body-inner{
    overflow:hidden;
    min-height:0;
  }

  .sec-body-pad{
    padding:0 26px 24px;
  }

  .sec-meta{
    display:flex; flex-wrap:wrap; gap:8px;
    margin-bottom:18px;
  }
  .pill{
    display:inline-flex; align-items:center; gap:7px;
    padding:5px 12px; border-radius:8px;
    border:1px solid var(--line);
    background:rgba(255,255,255,.025);
    font-family:var(--mono); font-size:10.5px;
    color:var(--muted);
    letter-spacing:.02em;
    transition:border-color .2s, background .2s;
  }
  .pill:hover{
    border-color:color-mix(in srgb, var(--sc) 30%, transparent);
    background:color-mix(in srgb, var(--sc) 6%, transparent);
  }
  .pill svg{width:11px; height:11px; flex:none; opacity:.6}
  .pill strong{
    color:#dbe4f2; font-weight:600;
    text-transform:uppercase; letter-spacing:.06em; font-size:9.5px;
  }

  .sec-block{margin-bottom:16px}
  .sec-block:last-child{margin-bottom:0}

  .block-label{
    font-size:10px; letter-spacing:.15em; text-transform:uppercase;
    color:var(--sc); font-weight:700;
    margin-bottom:11px;
    display:flex; align-items:center; gap:9px;
  }
  .block-label::after{
    content:'';
    flex:1; height:1px;
    background:linear-gradient(90deg, color-mix(in srgb, var(--sc) 30%, transparent), transparent);
  }

  .struct-list{
    list-style:none;
    display:flex; flex-direction:column; gap:9px;
  }
  .struct-list li{
    position:relative;
    padding-left:20px;
    font-size:13px; color:#c4cfe0;
    line-height:1.55;
    opacity:0;
    transform:translateX(-6px);
    transition:opacity .4s, transform .4s;
  }
  .section.is-open .struct-list li{
    opacity:1; transform:translateX(0);
  }
  .section.is-open .struct-list li:nth-child(1){transition-delay:.08s}
  .section.is-open .struct-list li:nth-child(2){transition-delay:.13s}
  .section.is-open .struct-list li:nth-child(3){transition-delay:.18s}
  .section.is-open .struct-list li:nth-child(4){transition-delay:.23s}
  .section.is-open .struct-list li:nth-child(5){transition-delay:.28s}
  .section.is-open .struct-list li:nth-child(6){transition-delay:.33s}
  .section.is-open .struct-list li:nth-child(7){transition-delay:.38s}
  .section.is-open .struct-list li:nth-child(8){transition-delay:.43s}

  .struct-list li::before{
    content:'';
    position:absolute; left:3px; top:9px;
    width:5px; height:5px; border-radius:50%;
    background:var(--sc); opacity:.75;
    box-shadow:0 0 8px color-mix(in srgb, var(--sc) 60%, transparent);
  }
  .struct-list li strong{color:#eef3fb; font-weight:600}
  .struct-list li em{color:var(--muted); font-style:normal; font-family:var(--mono); font-size:11.5px}
  .struct-list li code{
    font-family:var(--mono); font-size:11px;
    background:rgba(255,255,255,.055);
    border:1px solid var(--line);
    padding:1px 5px; border-radius:4px;
    color:#c9d4e6;
  }
  .struct-list li ul{
    margin-top:7px; padding-left:0;
    list-style:none;
    display:flex; flex-direction:column; gap:6px;
  }
  .struct-list li ul li{
    padding-left:14px; font-size:12px;
  }
  .struct-list li ul li::before{
    content:'·';
    position:absolute; left:3px; top:-2px;
    width:auto; height:auto; border-radius:0;
    background:none; box-shadow:none;
    color:var(--faint); font-size:14px;
  }

  .voice-notes{
    padding:15px 17px;
    border-radius:11px;
    border:1px solid var(--line);
    background:linear-gradient(180deg, rgba(251,191,36,.04), rgba(251,191,36,.008));
    position:relative;
    overflow:hidden;
  }
  .voice-notes::before{
    content:'';
    position:absolute; left:0; top:0; bottom:0; width:2px;
    background:linear-gradient(180deg, transparent, #fbbf24, transparent);
    opacity:.6;
  }
  .voice-notes .block-label{color:#fbbf24}
  .voice-notes .block-label::after{
    background:linear-gradient(90deg, rgba(251,191,36,.3), transparent);
  }
  .voice-notes ul{
    list-style:none;
    display:flex; flex-direction:column; gap:8px;
  }
  .voice-notes li{
    position:relative; padding-left:16px;
    font-size:12.5px; color:#b3c0d4; line-height:1.55;
  }
  .voice-notes li::before{
    content:'';
    position:absolute; left:0; top:8px;
    width:4px; height:4px; border-radius:50%;
    background:#fbbf24;
    box-shadow:0 0 8px rgba(251,191,36,.7);
  }

  /* ── example ── */

  .example{
    margin-top:16px;
    border-radius:12px;
    border:1px dashed color-mix(in srgb, var(--sc) 32%, transparent);
    background:color-mix(in srgb, var(--sc) 4%, transparent);
    overflow:hidden;
    display:none;
  }
  body.show-examples .example{
    display:block;
    animation:exampleIn .5s cubic-bezier(.2,.7,.3,1) backwards;
  }
  @keyframes exampleIn{
    from{opacity:0; transform:translateY(-4px)}
    to{opacity:1; transform:translateY(0)}
  }
  .example.is-open{display:block}

  .example-head{
    display:flex; align-items:center; gap:10px;
    padding:12px 16px;
    cursor:pointer;
    font-family:var(--mono); font-size:10.5px;
    color:color-mix(in srgb, var(--sc) 80%, #fff);
    letter-spacing:.04em;
    user-select:none;
    transition:background .2s;
  }
  .example-head:hover{background:color-mix(in srgb, var(--sc) 6%, transparent)}
  .example-head .arrow{
    font-size:10px;
    transition:transform .3s cubic-bezier(.2,.7,.3,1);
    color:color-mix(in srgb, var(--sc) 70%, transparent);
    display:inline-block;
  }
  .example.is-open .example-head .arrow{transform:rotate(90deg)}
  .example-head .tag{
    margin-left:auto;
    font-size:9px; letter-spacing:.14em; text-transform:uppercase;
    color:var(--faint);
  }

  .example-body-wrap{
    display:grid;
    grid-template-rows:0fr;
    transition:grid-template-rows .35s cubic-bezier(.3,.7,.3,1);
  }
  .example.is-open .example-body-wrap{grid-template-rows:1fr}
  .example-body-inner{overflow:hidden; min-height:0}

  .example-body{
    padding:0 16px 16px;
    font-size:12.5px; color:#b8c5d8;
    line-height:1.65;
  }
  .example-body p{margin-bottom:10px}
  .example-body p:last-child{margin-bottom:0}
  .example-body strong{color:#fff; font-weight:600}
  .example-body em{color:var(--muted); font-style:italic}
  .example-body ol, .example-body ul{
    padding-left:20px; margin:8px 0 10px;
    font-size:12.5px; line-height:1.6; color:#b8c5d8;
  }
  .example-body li{margin-bottom:5px}

  .example-body table{
    width:100%; border-collapse:collapse;
    font-size:11.5px; margin:10px 0;
  }
  .example-body table th,
  .example-body table td{
    padding:7px 9px; text-align:left;
    border-bottom:1px solid var(--line);
  }
  .example-body table th{
    font-size:9.5px; letter-spacing:.1em; text-transform:uppercase;
    color:var(--faint); font-weight:600;
    background:rgba(255,255,255,.02);
  }
  .example-body table td:first-child{
    font-family:var(--mono); font-size:10.5px;
    color:var(--muted);
  }

  /* ═══════════ HEURISTICS ═══════════ */

  .heuristics{
    margin-top:60px;
    padding:32px 34px 34px;
    border-radius:20px;
    border:1px solid var(--line);
    background:linear-gradient(180deg, rgba(167,139,250,.055), rgba(96,165,250,.015));
    position:relative;
    overflow:hidden;
    opacity:0;
    transform:translateY(24px);
    transition:opacity .7s, transform .7s cubic-bezier(.2,.7,.3,1);
  }
  .heuristics.in-view{opacity:1; transform:translateY(0)}
  .heuristics::before{
    content:'';
    position:absolute; top:0; left:0; right:0; height:2px;
    background:linear-gradient(90deg, transparent, #a78bfa, #60a5fa, #f472b6, transparent);
    opacity:.7;
    background-size:200% 100%;
    animation:gradShift 6s ease infinite;
  }

  .heur-head{
    display:flex; align-items:center; gap:12px;
    margin-bottom:22px;
    flex-wrap:wrap;
  }
  .heur-badge{
    font-family:var(--mono); font-size:9.5px; font-weight:700;
    letter-spacing:.1em;
    color:#c4b5fd;
    padding:4px 9px; border-radius:6px;
    background:rgba(167,139,250,.12);
    border:1px solid rgba(167,139,250,.3);
  }
  .heur-title{
    font-size:15.5px; font-weight:650;
    color:#eef3fb; letter-spacing:-.01em;
  }
  .heur-sub{
    font-size:12px; color:var(--muted);
    margin-left:auto; max-width:280px;
    text-align:right; line-height:1.4;
  }

  .heur-list{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
    gap:11px;
  }
  .heur-item{
    position:relative;
    padding:15px 16px 14px 42px;
    border-radius:12px;
    border:1px solid var(--line);
    background:rgba(255,255,255,.02);
    transition:border-color .25s, background .25s, transform .25s, box-shadow .25s;
    overflow:hidden;
    opacity:0;
    transform:translateY(12px);
  }
  .heuristics.in-view .heur-item{
    opacity:1; transform:translateY(0);
  }
  .heuristics.in-view .heur-item:nth-child(1){transition:all .5s .1s cubic-bezier(.2,.7,.3,1)}
  .heuristics.in-view .heur-item:nth-child(2){transition:all .5s .15s cubic-bezier(.2,.7,.3,1)}
  .heuristics.in-view .heur-item:nth-child(3){transition:all .5s .2s cubic-bezier(.2,.7,.3,1)}
  .heuristics.in-view .heur-item:nth-child(4){transition:all .5s .25s cubic-bezier(.2,.7,.3,1)}
  .heuristics.in-view .heur-item:nth-child(5){transition:all .5s .3s cubic-bezier(.2,.7,.3,1)}
  .heuristics.in-view .heur-item:nth-child(6){transition:all .5s .35s cubic-bezier(.2,.7,.3,1)}
  .heuristics.in-view .heur-item:nth-child(7){transition:all .5s .4s cubic-bezier(.2,.7,.3,1)}
  .heuristics.in-view .heur-item:nth-child(8){transition:all .5s .45s cubic-bezier(.2,.7,.3,1)}
  .heuristics.in-view .heur-item:nth-child(9){transition:all .5s .5s cubic-bezier(.2,.7,.3,1)}

  .heur-item::before{
    content:'✓';
    position:absolute; left:15px; top:50%;
    transform:translateY(-50%);
    width:18px; height:18px;
    border-radius:50%;
    display:flex; align-items:center; justify-content:center;
    font-size:10px; font-weight:700;
    background:rgba(167,139,250,.15);
    border:1px solid rgba(167,139,250,.4);
    color:#c4b5fd;
    box-shadow:0 0 10px rgba(167,139,250,.3);
  }
  .heur-item:hover{
    border-color:rgba(167,139,250,.35);
    background:rgba(167,139,250,.045);
    transform:translateY(-2px);
    box-shadow:0 18px 40px -22px rgba(167,139,250,.6);
  }

  .heur-item .hn{
    font-family:var(--mono); font-size:9.5px; font-weight:700;
    color:#c4b5fd;
    letter-spacing:.08em;
    margin-bottom:6px;
    text-transform:uppercase;
  }
  .heur-item .ht{
    font-size:12px; color:#c4cfe0;
    line-height:1.55;
  }
  .heur-item .ht em{
    color:#e2e9f5; font-style:normal; font-weight:600;
  }
  .heur-item .ht code{
    font-family:var(--mono); font-size:10.5px;
    background:rgba(255,255,255,.06);
    border:1px solid var(--line);
    padding:1px 5px; border-radius:4px;
    color:#c9d4e6;
  }

  /* ═══════════ FOOTER ═══════════ */

  .doc-footer{
    margin-top:56px;
    padding-top:28px;
    border-top:1px solid var(--line);
    text-align:center;
    position:relative;
  }
  .doc-footer::before{
    content:'';
    position:absolute; top:-1px; left:50%; transform:translateX(-50%);
    width:80px; height:1px;
    background:linear-gradient(90deg, transparent, #a78bfa, transparent);
    box-shadow:0 0 12px #a78bfa;
  }
  .doc-footer p{
    font-size:11.5px; color:var(--faint);
    line-height:1.9; letter-spacing:.01em;
  }
  .doc-footer code{
    font-family:var(--mono); font-size:10.5px;
    background:rgba(255,255,255,.05);
    border:1px solid var(--line);
    padding:1px 6px; border-radius:4px;
    color:#c9d4e6;
  }

  /* ═══════════ RESPONSIVE ═══════════ */

  @media (max-width:1200px){
    :root{--sidebar-w:220px}
    main{padding:0 44px 110px}
  }
  @media (max-width:960px){
    .layout{grid-template-columns:1fr}
    .sidebar{
      position:static; height:auto;
      padding:16px 20px;
      border-right:none; border-bottom:1px solid var(--line);
      overflow-x:auto; overflow-y:hidden;
    }
    .side-nav{flex-direction:row; gap:6px; flex-wrap:nowrap}
    .side-item{flex:none; white-space:nowrap}
    .side-item.is-active::before{display:none}
    .side-label{display:none}
    main{padding:0 26px 90px; max-width:100%}
    .brand-sub{display:none}
    .print-btn span{display:none}
    .print-btn{padding:6px 9px}
    .sections{padding-left:26px}
    .section::after{left:-22px}
  }
  @media (max-width:620px){
    .hero{padding:44px 0 30px}
    .topbar-inner{padding:0 14px; gap:10px}
    .view-toggle{font-size:10.5px}
    .view-btn{padding:5px 9px}
    .section-head{padding:18px 18px 14px; gap:12px}
    .sec-body-pad{padding:0 18px 20px}
    .sec-title{font-size:15px}
    .sec-icon{width:36px; height:36px}
    .sec-icon svg{width:17px; height:17px}
    .heuristics{padding:24px 20px 26px}
    .heur-sub{display:none}
    .sections{padding-left:0}
    .sections::before{display:none}
    .section::after{display:none}
    .meta-cell{padding:12px 14px}
  }

  @media (prefers-reduced-motion:reduce){
    *, *::before, *::after{
      animation-duration:.01ms !important;
      animation-iteration-count:1 !important;
      transition-duration:.01ms !important;
    }
    .section, .heuristics, .heur-item{opacity:1; transform:none}
  }

  @media print{
    :root{
      --bg:#fff; --txt:#0a0d14; --muted:#4b5563; --faint:#9ca3af;
      --line:#e5e7eb; --line-2:#d1d5db;
    }
    body{background:#fff; color:#0a0d14}
    .bg-ambient, .cursor-glow, .topbar, .sidebar, .sec-toggle,
    .view-toggle, .print-btn, .example-head{display:none !important}
    .layout{display:block; max-width:100%; margin:0}
    main{padding:0; max-width:100%}
    .section, .heuristics{
      break-inside:avoid;
      border:1px solid #e5e7eb;
      background:#fff;
      margin-bottom:16px;
      opacity:1 !important; transform:none !important;
    }
    .sec-body{grid-template-rows:1fr !important}
    .struct-list li{opacity:1 !important; transform:none !important}
    .example{display:block !important; border-style:solid; background:#f9fafb}
    .example-body-wrap{grid-template-rows:1fr !important}
    .section::before, .section::after, .heuristics::before,
    .funnel-flow, .orb, .brand-mark, .stars{display:none}
    .sec-num-inline, .block-label{color:#374151}
    .block-label::after{background:#d1d5db}
    .heur-item, .pill, .meta, .stat, .funnel{background:#f9fafb}
    .struct-list li::before{background:#6b7280}
    .voice-notes li::before{background:#d97706}
    .heur-item::before{background:#ede9fe; border-color:#a78bfa; color:#7c3aed}
  }
</style>
</head>
<body>

<div class="bg-ambient" aria-hidden="true">
  <div class="stars"></div>
  <div class="orb o1"></div>
  <div class="orb o2"></div>
  <div class="orb o3"></div>
</div>
<div class="cursor-glow" id="cursor-glow" aria-hidden="true"></div>

<header class="topbar">
  <div class="topbar-inner">
    <div class="brand">
      <span class="brand-mark"></span>
      <span>Astra</span>
      <span class="brand-sub">/ marketing plan v1</span>
    </div>

    <div class="topbar-spacer"></div>

    <div class="view-toggle" role="tablist" aria-label="View mode">
      <span class="view-pill" id="view-pill"></span>
      <button class="view-btn is-active" data-view="structure" role="tab">Structure</button>
      <button class="view-btn" data-view="reference" role="tab">Reference</button>
    </div>

    <button class="print-btn" onclick="window.print()" title="Print or export as PDF">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="6 9 6 2 18 2 18 9"/>
        <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/>
        <rect x="6" y="14" width="12" height="8"/>
      </svg>
      <span>Export</span>
    </button>
  </div>
  <div class="progress-track"><div class="progress-fill" id="progress-fill"></div></div>
</header>

<div class="layout">

  <aside class="sidebar">
    <div class="side-label">Sections</div>
    <nav class="side-nav" id="side-nav"></nav>
  </aside>

  <main>

    <section class="hero">
      <span class="eyebrow"><i></i>For Milad</span>

      <div class="hero-grid">
        <div>
          <h1>A <span class="grad">13-section</span><br>marketing plan</h1>
          <p class="lede">
            Every section has a <strong>purpose</strong>, a <strong>length</strong>,
            a shape, and inline prompts for what to draft. Switch to
            <em>Reference</em> above to see the working version for
            <strong>Astra</strong> in context.
          </p>
        </div>

        <div class="funnel-wrap" aria-hidden="true">
          <div class="funnel">
            <div class="funnel-flow"></div>

            <div class="funnel-stage">
              <div class="fs-inner" style="--c:#a78bfa; --w:100%">
                <span class="fs-dot"></span>
                <span class="fs-label">Acquisition</span>
                <span class="fs-count">42</span>
              </div>
            </div>
            <div class="funnel-stage">
              <div class="fs-inner" style="--c:#60a5fa; --w:78%">
                <span class="fs-dot"></span>
                <span class="fs-label">Activation</span>
                <span class="fs-count">6</span>
              </div>
            </div>
            <div class="funnel-stage">
              <div class="fs-inner" style="--c:#22d3ee; --w:60%">
                <span class="fs-dot"></span>
                <span class="fs-label">Retention</span>
                <span class="fs-count">7</span>
              </div>
            </div>
            <div class="funnel-stage">
              <div class="fs-inner" style="--c:#f472b6; --w:44%">
                <span class="fs-dot"></span>
                <span class="fs-label">Referral</span>
                <span class="fs-count">4</span>
              </div>
            </div>
            <div class="funnel-stage">
              <div class="fs-inner" style="--c:#fbbf24; --w:28%">
                <span class="fs-dot"></span>
                <span class="fs-label">Revenue</span>
                <span class="fs-count">3</span>
              </div>
            </div>
          </div>
