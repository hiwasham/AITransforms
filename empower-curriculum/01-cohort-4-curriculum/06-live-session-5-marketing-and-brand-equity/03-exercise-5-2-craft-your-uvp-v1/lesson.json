              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Let Claude guide you through the process. The more specific and honest you are, the more tailored and effective the guidance will be.",
                      "type": "text"
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Claude will create an artifact as the output. Select “Copy to Project” to add the artifact to your project knowledge. ",
                      "type": "text"
                    }
                  ]
                }
              ]
