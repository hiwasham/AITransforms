              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Rename the chat “Market to Lead” (so you can easily find it later).",
                      "type": "text"
                    }
                  ]
