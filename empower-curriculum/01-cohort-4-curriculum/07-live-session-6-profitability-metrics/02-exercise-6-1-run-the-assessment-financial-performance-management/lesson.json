        {
          "type": "paragraph",
          "content": [
            {
              "text": "To assess your organization’s financial performance management process, gauge the owner involvement, and identify areas for improvement. ",
              "type": "text",
              "circle_ios_fallback_text": "To assess your organization’s financial performance management process, gauge the owner involvement, and identify areas for improvement. "
            }
