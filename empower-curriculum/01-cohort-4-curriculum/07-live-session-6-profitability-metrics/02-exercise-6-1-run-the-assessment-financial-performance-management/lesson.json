            "level": 2
          },
          "content": [
            {
              "text": "🚨 Note on Owner Involvement in Financial Oversight",
              "type": "text",
              "circle_ios_fallback_text": "🚨 Note on Owner Involvement in Financial Oversight"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Unlike other processes where we encourage delegation, financial oversight requires owner involvement for fiduciary responsibility, strategic decision-making, and business protection. ",
              "type": "text",
              "circle_ios_fallback_text": "Unlike other processes where we encourage delegation, financial oversight requires owner involvement for fiduciary responsibility, strategic decision-making, and business protection. "
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "The goal is ",
              "type": "text",
              "marks": [
                {
                  "type": "bold"
                }
              ],
              "circle_ios_fallback_text": "The goal is "
            },
            {
              "text": "efficient",
              "type": "text",
              "marks": [
                {
                  "type": "bold"
                },
                {
                  "type": "italic"
                }
              ],
              "circle_ios_fallback_text": "efficient"
            },
            {
              "text": " owner involvement, not elimination of owner involvement.",
              "type": "text",
              "marks": [
                {
                  "type": "bold"
                }
              ],
              "circle_ios_fallback_text": " owner involvement, not elimination of owner involvement."
            }
          ]
        },
