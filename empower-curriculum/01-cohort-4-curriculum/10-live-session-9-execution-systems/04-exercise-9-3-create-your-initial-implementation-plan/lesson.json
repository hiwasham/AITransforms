              "circle_ios_fallback_text": "Purpose"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "To plan and prepare for the first process implementation in your business. ",
              "type": "text",
              "circle_ios_fallback_text": "To plan and prepare for the first process implementation in your business. "
            }
