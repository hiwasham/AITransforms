                            "rel": "noopener noreferrer nofollow",
                            "href": "mailto:support@circle.so",
                            "class": null,
                            "target": "_blank"
                          }
                        }
                      ]
                    },
                    {
                      "text": ". To receive the quickest assistance, please make sure to contact them using the same email that is associated with your Circle profile.",
                      "type": "text"
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
