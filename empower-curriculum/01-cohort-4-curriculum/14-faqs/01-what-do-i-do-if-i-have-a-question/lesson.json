              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "For technical support related to Circle (such as app concerns or login issues, etc.), please reach out to the Circle team at ",
                      "type": "text"
                    },
                    {
                      "text": "support@circle.so",
                      "type": "text",
