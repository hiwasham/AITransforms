        },
        {
          "type": "orderedList",
          "attrs": {
            "type": null,
            "start": 1
          },
          "content": [
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Use Circle’s search function to check if someone else has already asked the question, and the answer is available. ",
                      "type": "text"
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Post your question in the ",
                      "type": "text"
                    },
                    {
                      "type": "entity",
                      "attrs": {
