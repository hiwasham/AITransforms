              "circle_ios_fallback_text": "How to ask a great question"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "The better your question, the better the support you’ll receive. Here’s a simple framework to get the most out of your post:",
              "type": "text",
              "circle_ios_fallback_text": "The better your question, the better the support you’ll receive. Here’s a simple framework to get the most out of your post:"
            }
          ]
        },
        {
          "type": "orderedList",
          "attrs": {
            "type": null,
            "start": 1
          },
          "content": [
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Core process:",
                      "type": "text",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "text": " Which core process are you working on? (e.g. market to lead)",
                      "type": "text"
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Challenge:",
                      "type": "text",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "text": " Where exactly are you stuck or uncertain?",
                      "type": "text"
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "What you’ve tried:",
                      "type": "text",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "text": " What have you already done or considered?",
                      "type": "text"
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "What kind of input you want:",
                      "type": "text",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "text": " Do you want ideas, feedback, examples, or troubleshooting?",
                      "type": "text"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Example:",
              "type": "text",
              "marks": [
                {
                  "type": "bold"
                }
              ],
              "circle_ios_fallback_text": "Example:"
            }
          ]
        },
        {
          "type": "blockquote",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "text": "“I’m creating my Master Prompt and trying to articulate my company’s core values. I’ve drafted 3 but they still feel generic. I’m looking for feedback or examples—how did you make yours feel truly unique?”",
                  "type": "text",
                  "circle_ios_fallback_text": "“I’m creating my Master Prompt and trying to articulate my company’s core values. I’ve drafted 3 but they still feel generic. I’m looking for feedback or examples—how did you make yours feel truly unique?”"
                }
              ]
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Feel free to be concise, vulnerable, or even messy. This is a beta experience—everything here is a work in progress.",
              "type": "text",
              "circle_ios_fallback_text": "Feel free to be concise, vulnerable, or even messy. This is a beta experience—everything here is a work in progress."
