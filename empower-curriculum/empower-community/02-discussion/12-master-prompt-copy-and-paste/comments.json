    "tiptap_body": {
      "body": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "text": "Hre it is if anyone else runs into the same issue. ",
                "type": "text",
                "circle_ios_fallback_text": "Hre it is if anyone else runs into the same issue. "
              },
              {
                "type": "hardBreak",
                "circle_ios_fallback_text": "\n"
              },
              {
                "type": "hardBreak",
                "circle_ios_fallback_text": "\n"
              },
              {
                "text": "Prompt",
                "type": "text",
                "marks": [
                  {
                    "type": "bold"
                  }
                ],
                "circle_ios_fallback_text": "Prompt"
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "text": "Help me create a comprehensive master prompt that I can share with you to get better, more personalized assistance and advice.",
                "type": "text",
                "circle_ios_fallback_text": "Help me create a comprehensive master prompt that I can share with you to get better, more personalized assistance and advice."
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "text": "I'll answer questions across 6 key areas, and then you'll compile my responses into a polished master prompt document.",
                "type": "text",
                "circle_ios_fallback_text": "I'll answer questions across 6 key areas, and then you'll compile my responses into a polished master prompt document."
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "text": "Instructions:",
                "type": "text",
                "marks": [
                  {
                    "type": "bold"
                  }
                ],
                "circle_ios_fallback_text": "Instructions:"
              }
            ]
          },
          {
            "type": "bulletList",
            "content": [
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "text": "Ask me questions one by one from one section at a time",
                        "type": "text"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "text": "Wait for my complete responses before moving to the next section",
                        "type": "text"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "text": "Feel free to ask follow-up questions if my answers need clarification",
