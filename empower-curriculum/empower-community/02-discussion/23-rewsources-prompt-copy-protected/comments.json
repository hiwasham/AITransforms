                "circle_ios_fallback_text": "Help me create a list of my organization’s resources. Ask me questions, one by one, to identify our:"
              }
            ]
          },
          {
            "type": "bulletList",
            "content": [
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "text": "Capital: Cash, credit, investment funds",
                        "type": "text",
                        "marks": [
                          {
                            "type": "italic"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "text": "Physical: Equipment, facilities, inventory",
                        "type": "text",
                        "marks": [
                          {
                            "type": "italic"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "text": "Intellectual: Patents, copyrights, trade secrets, customer lists",
                        "type": "text",
                        "marks": [
                          {
                            "type": "italic"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "text": "Brand: Reputation, trust, customer relationships",
                        "type": "text",
                        "marks": [
                          {
                            "type": "italic"
                          }
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "text": "People: Employees with their skills, knowledge, relationships (you already know some of the people in my organization)",
                        "type": "text",
                        "marks": [
                          {
                            "type": "italic"
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "text": "Then compile my responses into a separate artifact.",
                "type": "text",
                "marks": [
