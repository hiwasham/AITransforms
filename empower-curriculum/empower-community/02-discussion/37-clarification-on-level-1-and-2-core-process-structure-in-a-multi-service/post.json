            },
            {
              "text": "Sale to Delivery",
              "type": "text",
              "circle_ios_fallback_text": "Sale to Delivery"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Challenge:",
              "type": "text",
              "marks": [
                {
                  "type": "bold"
                }
              ],
              "circle_ios_fallback_text": "Challenge:"
            },
            {
              "type": "hardBreak",
              "circle_ios_fallback_text": "\n"
            },
            {
              "text": "I’m unsure how to properly structure my Level 1 and Level 2 SOPs because my agency offers multiple services (both one-off and retainer-based), and clients often engage us for a mix of them depending on the goals.",
              "type": "text",
              "circle_ios_fallback_text": "I’m unsure how to properly structure my Level 1 and Level 2 SOPs because my agency offers multiple services (both one-off and retainer-based), and clients often engage us for a mix of them depending on the goals."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "text": "Our services include:",
              "type": "text",
              "circle_ios_fallback_text": "Our services include:"
            }
          ]
        },
        {
          "type": "bulletList",
          "content": [
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "text": "Branding (one-off)",
                      "type": "text"
                    }
                  ]
                }
              ]
            },
