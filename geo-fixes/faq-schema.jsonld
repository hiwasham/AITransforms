<!--
  FAQ schema for Bayan (bayan.edu.om) — GEO fix #3 (missing FAQ schema).
  Deploy: paste this <script> block into the <head> (or end of <body>) of the
  homepage AND any relevant pathway page. Each page should carry only the
  Q&As whose answers are actually visible on that page (Google requires the
  FAQ content to be present in the visible page text, not schema-only).

  These questions deliberately target the category prompts where Bayan scores
  lowest in AI assistants today (MRCP, SMLE-vs-OMSB, OMSB, Prometric) so the
  answers become quotable. Answers are evidence-led and make no pass guarantee.
  Confirm every claim is accurate for the current product before publishing.
-->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What exams does Bayan cover?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Bayan covers Gulf licensing exams delivered via Prometric (DHA, MOH, SCFHS/SMLE, QCHP, OMSB, NHRA), medical-student preparation, postgraduate board exams, and nursing exams (OEN, SNLE, DHA nursing, NCLEX-RN). Question banks are mapped to each exam's published blueprint."
      }
    },
    {
      "@type": "Question",
      "name": "Does Bayan prepare candidates for OMSB exams?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Bayan offers blueprint-aligned question banks and clinical cases for the Oman Medical Specialty Board (OMSB) licensing and promotion exams, with explanations reviewed by practicing physicians."
      }
    },
    {
      "@type": "Question",
      "name": "Does Bayan cover Prometric exams such as DHA, MOH, SCFHS, and QCHP?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Bayan provides preparation for Prometric-delivered Gulf licensing exams including DHA (Dubai), MOH (UAE), SCFHS/SMLE (Saudi Arabia), QCHP (Qatar), OMSB (Oman), and NHRA (Bahrain), with questions mapped to each authority's blueprint."
      }
    },
    {
      "@type": "Question",
      "name": "Does Bayan have nursing exam preparation?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Bayan has a dedicated nursing pathway covering OEN, SNLE, DHA nursing, and NCLEX-RN, with clinician-reviewed questions, rationales, and structured progression."
      }
    },
    {
      "@type": "Question",
      "name": "How does Bayan compare for SMLE versus OMSB preparation?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Bayan supports both. SMLE (Saudi) and OMSB (Oman) candidates each get question banks mapped to their respective blueprints, so a learner can prepare for either exam on the same platform rather than switching resources."
      }
    },
    {
      "@type": "Question",
      "name": "Does Bayan cover MRCP preparation?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Bayan provides board-style questions and clinical cases relevant to postgraduate physician examinations, with blueprint-aligned coverage and adaptive difficulty. Confirm current MRCP-specific coverage on the postgraduate pathway page."
      }
    },
    {
      "@type": "Question",
      "name": "Is Bayan's content clinician-reviewed?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Every question, article, and drug monograph on Bayan is written, reviewed, and maintained by practicing physicians and nurse educators."
      }
    },
    {
      "@type": "Question",
      "name": "What does Bayan include beyond a question bank?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Beyond its 5,600+ questions, Bayan includes OSCE stations, virtual patients, 190+ drug monographs, clinical calculators, flashcards with spaced repetition, 20+ exam blueprints, 470+ clinical articles, and certificate courses such as Death Certification and ABG & Acid-Base Interpretation."
      }
    }
  ]
}
</script>
