2",y:"16",width:"6",height:"6",rx:"1",key:"8cvhb9"}],["rect",{x:"9",y:"2",width:"6",height:"6",rx:"1",key:"1egb70"}],["path",{d:"M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3",key:"1jsf9p"}],["path",{d:"M12 12V8",key:"2874zd"}]]);var g=e.i(199660),f=e.i(990958),x=e.i(4937),b=e.i(529901),y=e.i(170462);let w=[{key:"influencer",steps:[{key:"influencer_discovery",build:()=>({title:"Influencer discovery campaign",subtitle:"Find relevant creators and public emails for a product you want to promote.",icon:f.Search,enabled:!0,focusSkills:["magister-influencer-campaign"],prompt:"Start an influencer discovery campaign for this brand.\n\nBefore asking me what to promote, review the company context already available in the workspace, including USER.md, BRAND.md, PLAN.md, and relevant files under audits/ when present.\n\nUse that evidence to suggest 2–4 specific products, services, offers, or topics that would make strong influencer campaigns. Give a one-line reason for each, then ask me to choose one or name a different option. If the context supports only one clear option, recommend it and ask me to confirm. If there is not enough reliable context, say what is missing and ask one focused question instead of inventing an offer. Do not call discovery until I choose or confirm a direction.\n\nOnce I choose, read and follow the `magister-influencer-campaign` skill — it defines the discovery endpoint, per-channel calls, limits, and exactly how to present results and emails. Default to Instagram, TikTok, and YouTube for product-led campaigns; add Reddit, LinkedIn, or X only if the product or audience makes those channels relevant or I ask for them.\n\nFinish with the top outreach angles and ask if I want you to draft outreach next."})},{key:"influencer_outreach",build:()=>({title:"Draft outreach to the top creators",subtitle:"Turn the shortlist into personal, per-creator emails you approve before anything sends.",icon:m.Mail,enabled:!0,focusSkills:["magister-influencer-campaign","magister-email"],prompt:"Draft outreach to the creators we already discovered for this brand.\n\nStart by re-reading the influencer discovery results in this brand. If there is no shortlist yet, say so and offer to run discovery first instead of inventing names.\n\n1. Pick the five creators with the best fit for our audience and offer, and say why each one in a sentence.\n2. Draft a short, personal email per creator — reference something specific about their actual content, not a mail-merge placeholder.\n3. Show me all five drafts in chat for approval.\n\nDo not send anything until I approve it, and send through the `magister-email` approval gate rather than any other path."})}]},{key:"ai_visibility",steps:[{key:"ai_visibility",build:({brandName:e})=>({title:"Check AI visibility",subtitle:"See how ChatGPT, Gemini, Claude, and Perplexity describe your brand.",icon:b.Sparkles,enabled:!!e,disabledReason:"Add a brand name to enable this.",prompt:e?`Set up an AI visibility tracker for ${e}.

Use the default AI visibility providers already configured in Magister. Confirm with me which brand terms to track before creating the tracker.

Once the tracker is created and the first round runs, summarize what each AI said about us, where we showed up vs. where competitors took the slot, and the one thing I should do this week to improve how we're described.`:""})},{key:"ai_visibility_improve",build:()=>({title:"Improve how AI describes us",subtitle:"Take the weakest prompts from the tracker and fix what the models are reading.",icon:b.Sparkles,enabled:!0,prompt:"Improve how AI assistants describe this brand, using the AI visibility tracker we already set up.\n\nRead the latest tracker round first. If no round has completed yet, say so and stop rather than guessing at the results.\n\n1. List the prompts where we are absent or described worst, and quote what the models actually said.\n2. For each one, identify why — missing page, thin content, no third-party mention, wrong framing on our own site.\n3. Recommend the three highest-impact changes, each with the exact page or asset to change and what to say instead.\n\nThis step is analysis and recommendation. Do not publish or edit anything without my explicit approval."})},{key:"ai_visibility_recheck",build:()=>({title:"Re-run the AI tracker and report movement",subtitle:"Run a fresh round and show what moved since the last one.",icon:y.TrendingUp,enabled:!0,prompt:"Run a fresh round of the AI visibility tracker for this brand and report what changed.\n\nCompare the new round against the previous one: which prompts we now appear in, which we lost, how our description changed, and which competitors gained or lost the slot.\n\nBe explicit about noise — model responses vary between rounds — and say which movements are large enough to act on and which are not. Finish with the single next change worth making."})}]},{key:"seo",steps:[{key:"seo_audit",build:({websiteUrl:e})=>({title:"Run an SEO audit",subtitle:"Crawl your site and get the top issues with prioritized fixes.",icon:c,enabled:!!e,disabledReason:"Add a website URL to your brand to enable this.",focusSkills:["magister-workflows"],prompt:e?`Run the \`seo-site-audit\` workflow against ${e}.

When it completes, walk me through the top issues with severity, business impact, and the single highest-priority fix to start with. If the workflow saves a report file, tell me the path so I can reference it later.`:""})},{key:"seo_fix_top_issues",build:({websiteUrl:e})=>({title:"Fix the top 3 issues the audit found",subtitle:"Turn the audit into approved, applied changes rather than a report nobody actions.",icon:p,enabled:!!e,disabledReason:"Add a website URL to your brand to enable this.",focusSkills:["magister-workflows","magister-audit-channel"],prompt:"Fix the highest-impact issues from the SEO audit we already ran for this brand.\n\nRead the most recent audit results first. If you cannot find them, say so and offer to re-run the audit rather than working from memory.\n\n1. Pick the three issues with the best impact-to-effort ratio and explain the reasoning.\n2. For each, show me the exact change — the page, the current state, and the proposed replacement.\n3. Check which website or CMS integration is connected before proposing to apply anything.\n\nDo not change a live site without my explicit approval. If no editable integration is connected, give me the changes as a prioritized brief and tell me which integration to connect."})},{key:"seo_reaudit",build:({websiteUrl:e})=>({title:"Re-audit and compare",subtitle:"Prove the fixes worked — or find what the first pass missed.",icon:y.TrendingUp,enabled:!!e,disabledReason:"Add a website URL to your brand to enable this.",focusSkills:["magister-workflows"],prompt:"Re-run the SEO audit for this brand and compare it against the previous run.\n\nShow what improved, what regressed, and what never got fixed. Be explicit about issues that look resolved only because the crawler saw a different set of pages.\n\nFinish with the next three things worth fixing, and say whether the previous round of changes actually moved anything measurable."})}]},{key:"content",steps:[{key:"blog_post",build:({websiteUrl:e})=>({title:"Write and publish a blog post",subtitle:"Turn your audit and plan into a draft, CMS-ready post, and launch snippets.",icon:g.PenLine,enabled:!0,focusSkills:["magister-workflows"],prompt:["Write and publish a blog post for this brand.\n",e?`Use ${e}, the Magister Audit, the first-week roadmap, and any brand context files to pick the strongest topic.`:"Use the Magister Audit, the first-week roadmap, and any brand context files to pick the strongest topic. If there is no website URL in the brand, ask me for it before doing CMS or SEO-specific work.","\nStart by proposing the topic, search intent, outline, title, slug, meta title, meta description, CTA, and the CMS you plan to publish to. Then write the full draft.\n\nCheck whether WordPress, Webflow, Shopify, or another CMS integration is connected before attempting to create a draft. If a CMS is connected, prepare the post as a draft in that CMS. If no CMS is connected, give me a publish-ready Markdown version and tell me which integration to connect.\n\nDo not publish anything live without my explicit approval. After I approve the draft and destination, publish it or schedule it, then create 3 social snippets to promote it."].join("\n")})},{key:"blog_post_next_three",build:()=>({title:"Plan the next three posts",subtitle:"Build a short content run from what already ranks instead of starting cold each time.",icon:g.PenLine,enabled:!0,focusSkills:["magister-workflows"],prompt:"Plan the next three blog posts for this brand.\n\nStart from evidence, not a brainstorm: the posts we already published, what the audit says about content gaps, and — if Search Console is connected — the queries and pages already earning impressions.\n\nFor each of the three, give me the topic, the search intent, the primary query, the internal links it should carry, and what makes it different from what we already published. Rank them and say which to write first and why.\n\nDo not write the drafts yet. Once I pick one, write that post in full."})}]},{key:"email",steps:[{key:"email_lead",build:()=>({title:"Send an email to a lead",subtitle:"Draft a one-off email from Magister's agent address for approval.",icon:m.Mail,enabled:!0,focusSkills:["magister-email"],prompt:"Help me send an email to a lead from Magister's agent email address for this brand.\n\nFirst ask me for the lead's email address, name, company, and the outcome I want from the email if any of those details are missing.\n\nDraft the email in chat first — concise, personal, and based on brand context where useful.\n\nAfter I approve the draft, read and follow the `magister-email` skill to send it through Magister's approval gate from the agent's own email address. Do not bypass approval."})},{key:"email_followup",build:()=>({title:"Write the follow-up sequence",subtitle:"Two or three follow-ups that add something new each time, ready for approval.",icon:m.Mail,enabled:!0,focusSkills:["magister-email"],prompt:"Write a follow-up sequence for the lead email we already sent from this brand.\n\nRead the sent email first so the follow-ups build on it rather than repeating it.\n\nDraft two or three follow-ups with sensible spacing. Each one must add something the previous did not — a proof point, a different angle, a lighter ask. The last one should make it easy to say no.\n\nShow me all of them in chat. Send nothing until I approve, and send through the `magister-email` approval gate."})}]},{key:"social",steps:[{key:"social_posting",build:()=>({title:"Draft and schedule a social post",subtitle:"Pick a connected platform and Magister drafts the first post for review.",icon:x.Share2,enabled:!0,focusSkills:["magister-zernio"],prompt:"Help me draft and schedule my first social media post.\n\nUse the native social-account and social-posting actions to check connected platforms and create or schedule the approved post. If no platform is connected, tell me to connect one in Settings > Integrations or the Social tab in the right panel, then stop.\n\nIf I have at least one platform connected, suggest 2-3 post ideas based on my marketing plan, let me pick one, then draft it in the platform's native style and queue it for tomorrow morning. Confirm the final draft and schedule with me before anything goes live."})},{key:"social_week",build:()=>({title:"Schedule a week of posts",subtitle:"Build a week around whatever already performed, queued for your approval.",icon:x.Share2,enabled:!0,focusSkills:["magister-zernio","magister-social-analytics"],prompt:"Plan and queue a week of social posts for this brand.\n\nStart from what we already posted and how it performed. If there is no performance data yet, say so and plan from the marketing plan instead of inventing numbers.\n\nPropose a week of posts across the connected platforms — a mix of formats and themes, each in the platform's native voice, with the day and time you recommend and why.\n\nShow me the full week in chat before anything is created. After I approve, queue them as drafts or scheduled posts. Nothing goes live without my approval."})}]},{key:"social_analytics",steps:[{key:"social_analytics_optimization",build:()=>({title:"Analyze social performance",subtitle:"Fetch social analytics and show what to optimize next.",icon:l.BarChart3,enabled:!0,focusSkills:["magister-social-analytics","magister-zernio","social"],prompt:"Analyze my social media performance and tell me what to optimize.\n\nRead and follow the `magister-social-analytics` skill — it defines the analytics endpoints, availability handling, and how to interpret the data. Pull the last 90 days for this brand. If analytics access is unavailable, explain that engagement metrics are not enabled yet and report only what can be learned from available posts or schedule data; do not retry. If there are no posts in the window, use the native social-account and social-post reads to distinguish no published posts from a date-window issue.\n\nSummarize performance by platform, content theme, and post format. Identify the top 3 posts, underperforming patterns, posting-time opportunities, follower-growth signals, and any stale or incomplete data.\n\nFinish with a prioritized optimization plan: what to post more of, what to stop or change, best days/times to test next, caption or creative changes, and 3 concrete post ideas for the next week. Do not create, schedule, or publish posts unless I ask."})},{key:"social_analytics_apply",build:()=>({title:"Apply the top recommendation",subtitle:"Turn the analysis into posts that test the single best idea.",icon:y.TrendingUp,enabled:!0,focusSkills:["magister-social-analytics","magister-zernio"],prompt:"Act on the top recommendation from the social performance analysis we already ran.\n\nRe-read the analysis first and restate the one recommendation you are acting on, so we agree before anything is created.\n\nDraft the posts that test it, on the platform and at the times the analysis pointed to, and say what result would prove it worked.\n\nShow me the drafts for approval. Do not publish or schedule anything without it."})}]},{key:"instagram",steps:[{key:"instagram_photo_video",build:()=>({title:"Generate an Instagram photo + video post",subtitle:"Create a feed image, short Reel-style video, caption, and schedule it for review.",icon:u.Instagram,enabled:!0,focusSkills:["social","video","magister-gemini-image","magister-zernio"],prompt:"Create an Instagram photo and video post for this brand.\n\nUse the native social-account and social-post actions for account checks, media upload, and post creation, and the `social`, `video`, and `magister-gemini-image` skills for content and asset generation. If no usable Instagram account is connected, tell me to connect Instagram in Settings > Integrations or the Social tab in the right panel, then stop. If multiple Instagram accounts are connected, ask which account to use.\n\nUse the marketing plan, audit, brand files, and brand context to propose one campaign concept. If the product, offer, or goal is unclear, ask me for it before generating media.\n\nDraft an Instagram caption with a clear CTA and relevant hashtags, then generate two assets: a square 1080x1080 feed image and a vertical 9:16 Reel-style video, 6-10 seconds. Avoid tiny text in generated media; keep any visible text short and readable.\n\nSave the generated media under resources and show me the caption, the image, and the video for explicit approval. If video generation is unavailable in this session, say so and provide the exact video prompt/storyboard instead; do not post a placeholder video.\n\nAfter I approve the final caption and assets, upload the media and create the draft or scheduled Instagram post per the skill. Do not publish live without my explicit approval."})},{key:"instagram_double_down",build:()=>({title:"Cut two more from the best performer",subtitle:"Take what worked and make more of it, not something new.",icon:u.Instagram,enabled:!0,focusSkills:["social","video","magister-gemini-image","magister-zernio"],prompt:"Make two more Instagram posts based on the best-performing one we already created for this brand.\n\nIdentify which of our posts performed best and say what specifically worked — hook, format, subject, caption structure. If performance data is not available, say so and pick based on the concept instead of pretending to have numbers.\n\nGenerate two variations that keep what worked and change one variable each, so we learn something from the comparison. Draft the captions to match.\n\nShow me both for approval before uploading. Nothing goes live without it."})}]},{key:"site_architecture",steps:[{key:"site_architecture",build:({websiteUrl:e})=>({title:"Optimize Site Architecture",subtitle:"Audit structure, pages, and content, then prepare approved website edits.",icon:p,enabled:!!e,disabledReason:"Add a website URL to your brand to enable this.",focusSkills:["magister-workflows","magister-audit-channel","magister-webflow","magister-wordpress","magister-wix","magister-shopify"],prompt:e?`Optimize the site architecture and website content for ${e}.

First run the \`seo-site-audit\` workflow and refresh the Magister Audit \`website_and_content\` channel using \`magister-audit-channel\`. If the channel refresh returns 404 because there is no completed audit yet, continue from the SEO audit and current brand context.

Use those results to identify the highest-impact improvements across navigation, page hierarchy, internal links, headings, metadata, conversion copy, content gaps, schema, and landing-page clarity.

Check which website/CMS integration is connected before editing: Webflow, WordPress, Wix, Shopify, GitHub, or another site integration. Propose the exact edits first, grouped by page and expected impact.

Do not publish live website changes without my explicit approval. After I approve, apply the edits through the connected integration when possible. If no editable site integration is connected, give me a prioritized implementation brief and tell me which integration to connect.`:""})},{key:"site_architecture_verify",build:({websiteUrl:e})=>({title:"Verify crawl and indexation",subtitle:"Confirm the structure changes were actually picked up, not just shipped.",icon:c,enabled:!!e,disabledReason:"Add a website URL to your brand to enable this.",focusSkills:["magister-workflows","magister-google-analytics"],prompt:"Verify that the site architecture changes we made for this brand were actually picked up.\n\nRe-crawl the site and, if Search Console is connected, check indexation and coverage for the pages we changed.\n\nReport: which changed pages are indexed, which are not and why, whether internal links resolve as intended, and whether anything regressed — orphaned pages, broken redirects, duplicate titles.\n\nThis is a read-only verification. Recommend fixes; do not apply them without my approval."})}]},{key:"ads",steps:[{key:"paid_ads_campaign",build:()=>({title:"Launch paid ads",subtitle:"Pick the right paid channel, draft creative, and prepare a campaign for approval.",icon:h.Megaphone,enabled:!0,focusSkills:["magister-zernio-ads","magister-google-ads"],prompt:"Launch paid ads for this brand.\n\nUse the Magister Audit, first-week roadmap, connected integrations, and brand context to recommend the best initial paid channel and offer. Use the native ad-account actions for Meta, TikTok, LinkedIn, Pinterest, and X, and `magister-google-ads` for Google Search campaigns.\n\nFirst check which ad accounts and paid media integrations are connected. If none are connected, tell me which integration to connect and still draft the campaign plan.\n\nPrepare the campaign strategy: objective, platform, audience, budget recommendation, duration, landing page, tracking needs, creative angles, copy, keywords if search ads apply, and the launch checklist.\n\nDo not create, activate, resume, or spend money on any campaign without my explicit approval of the platform, budget amount and type, duration or end condition, destination, and final creative. If I approve creation, create the campaign paused where the platform supports it, then ask before activating it."})},{key:"ads_review_spend",build:()=>({title:"Review spend and cut the worst performer",subtitle:"Read the campaign back, find what is wasting money, and propose the change.",icon:l.BarChart3,enabled:!0,focusSkills:["magister-zernio-ads","magister-google-ads"],prompt:"Review how the paid campaign we set up for this brand is performing.\n\nPull the live campaign, ad set, and creative performance. If the campaign has not spent enough to be readable yet, say exactly that and tell me when to look again rather than over-reading noise.\n\nReport spend, results, cost per result, and the spread between best and worst ad set. Identify what is wasting budget and what deserves more.\n\nRecommend one change. Do not pause, activate, adjust budget, or spend anything without my explicit approval — and never treat this review as approval to act."})}]}];w.flatMap(e=>e.steps.map(e=>e.key)),w.map(e=>e.key);let v=new Map(w.flatMap(e=>e.steps.map(t=>[t.key,e.key])));function k(e={}){let t=e.completedSteps??j,a=e.skippedTracks??j,n=[];for(let s of w){if(a.has(s.key))continue;let r=s.steps.find(e=>!t.has(e.key));r&&n.push({key:r.key,...r.build(e)})}return n}let j=new Set;e.s(["STARTER_TRACK_BY_STEP",0,v,"resolveStarterCards",0,k],713542);var N=e.i(975016),C=e.i(402523);function S({projectId:e}){let[t,a]=(0,N.useState)(()=>new Set),[n,s]=(0,N.useState)(null),[r,i]=(0,N.useState)(!1),o=(0,N.useCallback)((e,t)=>{a(a=>{let n=new Set(a);return t?n.add(e):n.delete(e),n})},[]),l=(0,N.useCallback)(async t=>{if(e){i(!1),o(t.itemId,!0),s(t);try{await (0,C.updatePlanItemStatus)(e,t.itemId,"completed")}catch{o(t.itemId,!1),s