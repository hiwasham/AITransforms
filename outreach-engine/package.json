{
  "name": "outreach-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Rule of 100 Outreach Engine — separate backend service, isolated from the AITransforms static site per FR-015.",
  "type": "module",
  "scripts": {
    "start": "node --experimental-transform-types --import ./loader.mjs src/server/main.ts",
    "start:dashboard": "node --experimental-transform-types --import ./loader.mjs src/server/dashboard-main.ts",
    "first-100": "node --experimental-transform-types --import ./loader.mjs scripts/first-100.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17"
  },
  "devDependencies": {
    "typescript": "^5",
    "vitest": "^4.1.9",
    "@types/node": "^22"
  }
}
