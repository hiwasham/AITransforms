{
  // Display name for this crew
  "name": "sharedlangcrew",

  // Agents to include — each must have a matching agents/<name>.jsonc file
  "agents": ["framework_personalizer", "communication_style_curator", "strategic_thinking_architect", "resource_discovery_coach", "resource_document_specialist"],

  // Task definitions — executed in order for sequential process
  "tasks": [
    {
      // Task identifier
      "name": "you_are_interviewing_the_task",

      // What the task should accomplish
      // Use {placeholder} inputs here; crewai run prompts for missing values
      "description": "\"You are interviewing the CEO to uncover all organizational resources.\\n\" \"---\\n\" \"**Master Prompt (context)**: {master_prompt_text}\\n\" \"---\\n\" \"If the master prompt already contains some resource information (e.g., team members, revenue, assets), \" \"you may reference it but still ask for confirmation and completeness.\\n\\n\" \"Ask the following questions **one at a time**, using the `ask_human` tool. \" \"Do not batch questions. Wait for a complete answer before moving to the next.\\n\\n\" \"**Resource Interview Questions:**\\n\" \"1. **Capital**: What is your current cash position? What access do you have to credit lines, loans, or investment funds?\\n\" \"2. **Physical**: What physical assets do you own or lease (equipment, office/facility space, vehicles, inventory)?\\n\" \"3. **Intellectual**: What intellectual property do you hold (patents, copyrights, trademarks, trade secrets, proprietary customer lists, software)?\\n\" \"4. **Brand**: How would you describe your brand reputation? How strong are your customer relationships and market trust?\\n\" \"5. **People**: Beyond what's already mentioned, who are your key team members? What unique skills, knowledge, industry relationships, or networks do they bring?\\n\\n\" \"After collecting all answers, produce a clean raw Q&A transcript. Format each Q and A clearly \" \"(e.g., 'Q1: ...\\\\nA1: ...'). Do not add extra commentary.\"",

      // Clear definition of what the output should look like
      "expected_output": "\"A plain text transcript containing all 5 resource questions with their corresponding answers, labelled clearly.\"",

      // Optional task guardrail(s) validate output before completion
      // Use "guardrail" for one rule or "guardrails" for many
      // Failed guardrails retry up to guardrail_max_retries times
      // "guardrail": "Every factual claim needs context support.",
      // "guardrails": [
      //   "Every factual claim must be supported by context.",
      //   "The answer must match the expected output format."
      // ],
      // "guardrail_max_retries": 2,

      // Advanced task options:
      // Docs: https://docs.crewai.com/concepts/tasks
      // "type": "ConditionalTask",
      // "condition": { "python": "my_project.conditions.should_run" },
      // "output_json": { "python": "my_project.models.ReportOutput" },
      // "output_pydantic": null,
      // "response_model": null,
      // "converter_cls": { "python": "my_project.converters.CustomConverter" },
      // "markdown": false,
      // "input_files": { "brief": "data/brief.txt" },
      // "security_config": {},

      // Which agent handles this task
      "agent": "resource_discovery_coach"

      // "tools": [],
      // "human_input": false,
      // "async_execution": false
    }
,
    {
      // Task identifier
      "name": "you_are_given_the_task",

      // What the task should accomplish
      // Use {placeholder} inputs here; crewai run prompts for missing values
      "description": "\"You are given the raw resource interview transcript from the previous task.\\n\" \"Your job is to format it into a polished Markdown document named `ceo_resources.md`.\\n\" \"---\\n\" \"**Requirements**:\\n\" \"- Start with the title: `# CEO Resources \u2013 {company_name}` (if company name is known from the Master Prompt; otherwise use just 'CEO Resources').\\n\" \"- Organise into exactly these sections: **Capital**, **Physical**, **Intellectual**, **Brand**, **People**.\\n\" \"- Under each section, present the answers in clean bullet points.\\n\" \"- **Preserve the CEO's original wording** \u2013 do not paraphrase or summarise.\\n\" \"- If any question was skipped or unanswered, insert `[Not provided]`.\\n\" \"- Use proper Markdown syntax (headings, bullet lists, bold for emphasis).\\n\" \"Return only the final Markdown content (no extra text).\"",

      // Clear definition of what the output should look like
      "expected_output": "\"A valid Markdown document ready to be saved as `ceo_resources.md`.\"",

      // Optional task guardrail(s) validate output before completion
      // Use "guardrail" for one rule or "guardrails" for many
      // Failed guardrails retry up to guardrail_max_retries times
      // "guardrail": "Every factual claim needs context support.",
      // "guardrails": [
      //   "Every factual claim must be supported by context.",
      //   "The answer must match the expected output format."
      // ],
      // "guardrail_max_retries": 2,

      // Advanced task options:
      // Docs: https://docs.crewai.com/concepts/tasks
      // "type": "ConditionalTask",
      // "condition": { "python": "my_project.conditions.should_run" },
      // "output_json": { "python": "my_project.models.ReportOutput" },
      // "output_pydantic": null,
      // "response_model": null,
      // "converter_cls": { "python": "my_project.converters.CustomConverter" },
      // "markdown": false,
      // "input_files": { "brief": "data/brief.txt" },
      // "security_config": {},

      // Which agent handles this task
      "agent": "resource_document_specialist",

      // Task outputs used as context
      "context": ["you_are_interviewing_the_task"]

      // "tools": [],
      // "human_input": false,
      // "async_execution": false
    }
,
    {
      // Task identifier
      "name": "you_are_to_personalise_task",

      // What the task should accomplish
      // Use {placeholder} inputs here; crewai run prompts for missing values
      "description": "\"You are to personalise the generic Business Process Framework using the CEO's master prompt.\\n\" \"---\\n\" \"**Master Prompt**: {master_prompt_text}\\n\" \"**Generic Framework (base)**:\\n\" \"{generic_framework_text}\\n\" \"---\\n\" \"**Instructions**:\\n\" \"- Keep the exact same three\u2011tier structure: **Strategic Planning**, **Core Value Chain (Customer Lifecycle)**, and **Enabling Processes**.\\n\" \"- Within each section, enrich the text to reflect the CEO's specific business:\\n\" \"   - Map their products/services to the relevant lifecycle stages (Market to Lead, Lead to Sale, Sale to Delivery, Delivery to Success, Success to Lead).\\n\" \"   - Replace generic placeholders with actual team member names, product names, or customer segments (where known from the Master Prompt).\\n\" \"   - Highlight the CEO's top 3 challenges in the relevant process areas (e.g., if they struggle with lead generation, flag that under 'Market to Lead').\\n\" \"   - Tailor the 'Goal' descriptions to match their industry (e.g., if they are B2B SaaS vs. agency vs. e\u2011commerce).\\n\" \"- Do **not** remove any core processes\u2014only add specificity.\\n\" \"- Add a header note at the top: `> This framework has been personalized for [CEO Name] \u2013 [Company Name]`.\\n\" \"- Produce the final document as `personalized_business_framework.md`.\\n\" \"Return only the Markdown content.\"",

      // Clear definition of what the output should look like
      "expected_output": "\"A personalized Markdown version of the Business Process Framework, tailored to the CEO's business context.\"",

      // Optional task guardrail(s) validate output before completion
      // Use "guardrail" for one rule or "guardrails" for many
      // Failed guardrails retry up to guardrail_max_retries times
      // "guardrail": "Every factual claim needs context support.",
      // "guardrails": [
      //   "Every factual claim must be supported by context.",
      //   "The answer must match the expected output format."
      // ],
      // "guardrail_max_retries": 2,

      // Advanced task options:
      // Docs: https://docs.crewai.com/concepts/tasks
      // "type": "ConditionalTask",
      // "condition": { "python": "my_project.conditions.should_run" },
      // "output_json": { "python": "my_project.models.ReportOutput" },
      // "output_pydantic": null,
      // "response_model": null,
      // "converter_cls": { "python": "my_project.converters.CustomConverter" },
      // "markdown": false,
      // "input_files": { "brief": "data/brief.txt" },
      // "security_config": {},

      // Which agent handles this task
      "agent": "framework_personalizer"

      // "tools": [],
      // "human_input": false,
      // "async_execution": false
    }
,
    {
      // Task identifier
      "name": "you_are_to_create_task",

      // What the task should accomplish
      // Use {placeholder} inputs here; crewai run prompts for missing values
      "description": "\"You are to create `style_preferences.md` \u2013 a document that defines how the AI should communicate with the CEO.\\n\"",

      // Clear definition of what the output should look like
      "expected_output": "\"---\\n\"",

      // Optional task guardrail(s) validate output before completion
      // Use "guardrail" for one rule or "guardrails" for many
      // Failed guardrails retry up to guardrail_max_retries times
      // "guardrail": "Every factual claim needs context support.",
      // "guardrails": [
      //   "Every factual claim must be supported by context.",
      //   "The answer must match the expected output format."
      // ],
      // "guardrail_max_retries": 2,

      // Advanced task options:
      // Docs: https://docs.crewai.com/concepts/tasks
      // "type": "ConditionalTask",
      // "condition": { "python": "my_project.conditions.should_run" },
      // "output_json": { "python": "my_project.models.ReportOutput" },
      // "output_pydantic": null,
      // "response_model": null,
      // "converter_cls": { "python": "my_project.converters.CustomConverter" },
      // "markdown": false,
      // "input_files": { "brief": "data/brief.txt" },
      // "security_config": {},

      // Which agent handles this task
      "agent": "communication_style_curator"

      // "tools": [],
      // "human_input": false,
      // "async_execution": false
    }
,
    {
      // Task identifier
      "name": "you_are_to_create_task_2",

      // What the task should accomplish
      // Use {placeholder} inputs here; crewai run prompts for missing values
      "description": "\"You are to create `strategic_approaches.md` \u2013 a document outlining the AI's default problem\u2011solving methodology.\\n\" \"---\\n\" \"**Master Prompt**: {master_prompt_text}\\n\" \"---\\n\" \"**Instructions**:\\n\" \"- Fully define the **1\u20113\u20111 Decision Framework**:\\n\" \"   - Determine the **problem** and the desired **outcome**.\\n\" \"   - Provide **3 potential paths** (options) to achieve the outcome.\\n\" \"   - Recommend **1 course of action** with rationale.\\n\" \"   - To gather the necessary context, you will ask **5 questions**, one at a time, based on what you know about the business. \" \"You will present your own answer to each question and then allow the CEO to edit or approve it before proceeding to the next.\\n\" \"- Adapt the approach to the CEO's industry and risk tolerance (e.g., agile speed for startups, deep analysis for established firms).\\n\" \"- Include additional principles: *'Start with the end in mind'*, *'Consider trade\u2011offs explicitly'*, *'Use data where available, but acknowledge gaps'*.\\n\" \"- Structure the document with these sections: **Decision\u2011Making Framework**, **Problem\u2011Solving Process**, **Handling Uncertainty & Trade\u2011offs**.\\n\" \"Return only the Markdown content.\"",

      // Clear definition of what the output should look like
      "expected_output": "\"A Markdown document describing strategic thinking approaches, ready to be saved as `strategic_approaches.md`.\"",

      // Optional task guardrail(s) validate output before completion
      // Use "guardrail" for one rule or "guardrails" for many
      // Failed guardrails retry up to guardrail_max_retries times
      // "guardrail": "Every factual claim needs context support.",
      // "guardrails": [
      //   "Every factual claim must be supported by context.",
      //   "The answer must match the expected output format."
      // ],
      // "guardrail_max_retries": 2,

      // Advanced task options:
      // Docs: https://docs.crewai.com/concepts/tasks
      // "type": "ConditionalTask",
      // "condition": { "python": "my_project.conditions.should_run" },
      // "output_json": { "python": "my_project.models.ReportOutput" },
      // "output_pydantic": null,
      // "response_model": null,
      // "converter_cls": { "python": "my_project.converters.CustomConverter" },
      // "markdown": false,
      // "input_files": { "brief": "data/brief.txt" },
      // "security_config": {},

      // Which agent handles this task
      "agent": "strategic_thinking_architect",

      // Task outputs used as context
      "context": ["you_are_interviewing_the_task", "you_are_to_personalise_task"]

      // "tools": [],
      // "human_input": false,
      // "async_execution": false
    }

  ],

  // Execution process
  // "sequential" — tasks run in order, each receiving prior task outputs
  // "hierarchical" — a manager agent delegates tasks (requires manager_llm)
  "process": "sequential",

  // Enable verbose logging during execution
  "verbose": true,

  // Enable crew memory — persists context and learnings across tasks
  "memory": true,

  // Automatically plan the execution strategy before running tasks
  // "planning": false,

  // LLM for the planning step (used when planning is true)
  // "planning_llm": "openai/gpt-4o",

  // LLM for the manager agent (required when process is "hierarchical")
  // "manager_llm": "openai/gpt-4o",

